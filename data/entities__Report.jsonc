{
  "name": "Report",
  "type": "object",
  "properties": {
    "reporter_email": {
      "type": "string",
      "title": "Reporter Email"
    },
    "listing_id": {
      "type": "string",
      "title": "Reported Listing ID"
    },
    "reported_user_email": {
      "type": "string",
      "title": "Reported User Email"
    },
    "reason": {
      "type": "string",
      "enum": [
        "fake_listing",
        "misleading_info",
        "duplicate",
        "fraud",
        "inappropriate",
        "other"
      ],
      "title": "Report Reason"
    },
    "details": {
      "type": "string",
      "title": "Additional Details"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "investigating",
        "resolved",
        "dismissed"
      ],
      "default": "open",
      "title": "Report Status"
    },
    "admin_notes": {
      "type": "string",
      "title": "Admin Notes"
    }
  },
  "required": [
    "reason",
    "details"
  ]
}