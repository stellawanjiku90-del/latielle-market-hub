NODE_ENV=production
PORT=10000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
CLIENT_URL=https://latielle-market-hub-1.onrender.com
VITE_API_URL=/api

CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
ADMIN_PHONES=+254703927978,+254706692111

MPESA_ENV=production
MPESA_SHORTCODE=YOUR_MPESA_SHORTCODE
MPESA_PASSKEY=YOUR_MPESA_PASSKEY
MPESA_CONSUMER_KEY=YOUR_DARAJA_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_DARAJA_CONSUMER_SECRET
MPESA_CALLBACK_URL=https://latielle-market-hub-1.onrender.com/api/payments/mpesa/callback
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# For an M-Pesa Till/Buy Goods number, use: CustomerBuyGoodsOnline
# Set MPESA_PARTY_B explicitly if it differs from MPESA_SHORTCODE.
