NODE_ENV=production
PORT=10000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
CLIENT_URL=https://latielle-market-hub-1.onrender.com
VITE_API_URL=/api

MPESA_ENV=production
MPESA_SHORTCODE=YOUR_MPESA_SHORTCODE
MPESA_PASSKEY=YOUR_MPESA_PASSKEY
MPESA_CONSUMER_KEY=YOUR_DARAJA_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_DARAJA_CONSUMER_SECRET
MPESA_CALLBACK_URL=https://latielle-market-hub-1.onrender.com/api/payments/mpesa/callback
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# For an M-Pesa Till/Buy Goods number, use: CustomerBuyGoodsOnline
# Set MPESA_PARTY_B explicitly if it differs from MPESA_SHORTCODE.

OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.6-luna
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=LATIELLE MARKET HUB <support@latiellemarkethub.co.ke>
SUPPORT_NOTIFICATION_EMAIL=realityofafrica2023@gmail.com
